# Master Mr. Agents - Environment Configuration
# All keys are optional: if omitted, Master Mr. Agents runs with its high-fidelity domain intelligence engine out-of-the-box!

# 1. Anthropic (Used by: The Orchestrator, The UI/UX Architect, The DevOps Engineer)
ANTHROPIC_API_KEY=

# 2. OpenAI / OpenRouter (Used by: The Backend Builder, The Sales Closer)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# 3. Google Gemini (Used by: The Multimodal Marketer, The QA Tester)
GEMINI_API_KEY=

# 4. Groq (Used by: The Data Scraper - Llama-3.3-70b)
GROQ_API_KEY=

# 5. Redis Message Queue (Optional: falls back to local high-speed in-memory event bus if empty)
REDIS_URL=redis://localhost:6379
