# Auto detect text files and perform LF normalization for code & config
* text=auto eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.zip binary

# Preserve byte-exact contents in canonical skills & dist for deterministic SHA-256 verification
skills/** -text
dist/skills/** -text
dist/pack-skills/** -text
manus-ready/** binary
